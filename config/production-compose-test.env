# Non-secret, disposable Linux Compose verification values. Not for a real VPS.
POSTGRES_DB=viralforge
POSTGRES_USER=viralforge
POSTGRES_PASSWORD=compose-test-only-very-long-password
VIRALFORGE_ENVIRONMENT=production
VIRALFORGE_DEPLOYMENT_MODE=production
VIRALFORGE_DATABASE_URL=postgresql+psycopg://viralforge:compose-test-only-very-long-password@postgres:5432/viralforge
VIRALFORGE_REDIS_URL=redis://redis:6379/0
VIRALFORGE_CELERY_BROKER_URL=redis://redis:6379/0
VIRALFORGE_CELERY_RESULT_BACKEND=redis://redis:6379/1
VIRALFORGE_API_SECRET=compose-test-api-secret-with-more-than-32-characters
VIRALFORGE_PREVIEW_HASHING_SECRET=compose-test-preview-secret-with-more-than-32
VIRALFORGE_ENABLE_DEVELOPMENT_ACTOR=false
VIRALFORGE_PUBLIC_HOST=app.example.test
VIRALFORGE_PUBLIC_BASE_URL=https://app.example.test
VIRALFORGE_API_BASE_URL=https://app.example.test
VIRALFORGE_PREVIEW_PUBLIC_BASE_URL=https://app.example.test
VIRALFORGE_OAUTH_CALLBACK_BASE_URL=https://app.example.test
VIRALFORGE_TRUSTED_HOSTS=app.example.test,localhost,api
VIRALFORGE_CORS_ALLOWED_ORIGINS=
VIRALFORGE_DISCORD_ENABLED=false
VIRALFORGE_SCHEDULER_HEARTBEAT_INTERVAL_SECONDS=10
VIRALFORGE_PUBLISHING_ENABLED=false
VIRALFORGE_PUBLISHING_YOUTUBE_ENABLED=false
VIRALFORGE_YOUTUBE_OAUTH_ENABLED=false
VIRALFORGE_TIKTOK_ENABLED=false
VIRALFORGE_ANALYTICS_ENABLED=false
VIRALFORGE_ANALYTICS_YOUTUBE_ENABLED=false
