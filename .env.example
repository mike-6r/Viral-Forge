# Local advisory rendered-media QA. Auto-run is opt-in per brand profile and
# cannot approve, reject, rerender, queue, schedule, upload, or publish media.
VIRALFORGE_RENDERED_MEDIA_INSPECTION_ENABLED=true
VIRALFORGE_RENDERED_MEDIA_INSPECTION_AUTO_RUN=false
