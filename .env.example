VIRALFORGE_OPPORTUNITY_VISUAL_WEIGHT=0.12
VIRALFORGE_CONTENT_PACKAGE_ENABLED=true
# Safe default: deterministic local templates; no network call is made.
VIRALFORGE_CONTENT_PACKAGE_PROVIDER=mock
# Configure both only to enable the optional external provider.
VIRALFORGE_CONTENT_PACKAGE_EXTERNAL_ENDPOINT=
VIRALFORGE_CONTENT_PACKAGE_EXTERNAL_API_KEY=
VIRALFORGE_CONTENT_PACKAGE_TIMEOUT_SECONDS=60
VIRALFORGE_CONTENT_PACKAGE_MAX_TRANSCRIPT_CHARS=600
# Review-first publishing remains disabled until an operator enables both flags.
# DestinationAccount.credential_reference_id accepts only an opaque external
# reference such as env://VIRALFORGE_YOUTUBE_OAUTH_ACCESS_TOKEN; never put the
# OAuth token in the database, account metadata, or logs.
VIRALFORGE_PUBLISHING_ENABLED=false
VIRALFORGE_PUBLISHING_YOUTUBE_ENABLED=false
VIRALFORGE_PUBLISHING_HTTP_TIMEOUT_SECONDS=30
VIRALFORGE_PUBLISHING_UPLOAD_TIMEOUT_SECONDS=1800
VIRALFORGE_PUBLISHING_MEDIA_PROBE_TIMEOUT_SECONDS=30
VIRALFORGE_PUBLISHING_MAX_ATTEMPTS=3
VIRALFORGE_PUBLISHING_RETRY_BACKOFF_SECONDS=60
# TikTok uses only the official Login Kit and Content Posting API. Keep the
# client secret and per-account token set in an external credential manager;
# use opaque env:// references in DestinationAccount records. Do not put raw
# tokens, authorization codes, cookies, or upload URLs in the database/logs.
VIRALFORGE_TIKTOK_ENABLED=false
VIRALFORGE_TIKTOK_CLIENT_ID=
VIRALFORGE_TIKTOK_CLIENT_SECRET_CREDENTIAL_REFERENCE=
# env is read-only for pre-provisioned credentials. Use encrypted_file on the
# single VPS for dynamic OAuth tokens; its Fernet master key must be supplied
# by a separate env:// reference or mounted secret, never committed here.
VIRALFORGE_CREDENTIAL_STORE_BACKEND=env
VIRALFORGE_CREDENTIAL_STORE_FILE_PATH=/data/credentials/viralforge-credentials.json
VIRALFORGE_CREDENTIAL_STORE_MASTER_KEY_REFERENCE=
VIRALFORGE_TIKTOK_OAUTH_STATE_SECRET=
VIRALFORGE_TIKTOK_OAUTH_STATE_TTL_SECONDS=600
VIRALFORGE_TIKTOK_APPLICATION_REVIEW_STATE=DEVELOPMENT
VIRALFORGE_TIKTOK_DRAFT_UPLOAD_ENABLED=false
VIRALFORGE_TIKTOK_DIRECT_POST_ENABLED=false
VIRALFORGE_TIKTOK_PUBLIC_DIRECT_POST_ENABLED=false
VIRALFORGE_TIKTOK_DEFAULT_MODE=DRAFT_UPLOAD
VIRALFORGE_TIKTOK_REQUEST_TIMEOUT_SECONDS=30
VIRALFORGE_TIKTOK_UPLOAD_TIMEOUT_SECONDS=1800
VIRALFORGE_TIKTOK_STATUS_POLL_INTERVAL_SECONDS=60
VIRALFORGE_TIKTOK_MAX_STATUS_POLL_ATTEMPTS=30
VIRALFORGE_TIKTOK_RETRY_COUNT=3
VIRALFORGE_TIKTOK_RETRY_BACKOFF_SECONDS=60
VIRALFORGE_TIKTOK_TRANSFER_CHUNK_SIZE_BYTES=10000000
VIRALFORGE_TIKTOK_MAX_MEDIA_BYTES=4000000000
VIRALFORGE_TIKTOK_MAX_TRANSFERS_PER_DAY=3
VIRALFORGE_TIKTOK_MINIMUM_TRANSFER_INTERVAL_SECONDS=300
VIRALFORGE_TIKTOK_MAX_PENDING_DRAFTS=5
VIRALFORGE_TIKTOK_CREDENTIAL_REFRESH_WINDOW_SECONDS=86400
VIRALFORGE_TIKTOK_EMERGENCY_PAUSE=true
VIRALFORGE_TIKTOK_PILOT_BRAND_SLUG=
# Analytics is read-only and disabled until a YouTube OAuth credential with
# analytics scope is externally referenced by the destination account.
VIRALFORGE_ANALYTICS_ENABLED=false
VIRALFORGE_ANALYTICS_YOUTUBE_ENABLED=false
VIRALFORGE_ANALYTICS_HTTP_TIMEOUT_SECONDS=30
VIRALFORGE_ANALYTICS_REFRESH_BATCH_SIZE=25
# Clip-correction policy is stored per brand in ContentProfile.clip_correction_json.
# It has no credentials and defaults to bounded, operator-confirmed corrections.
