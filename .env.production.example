# Copy to .env.production on the VPS, chmod 0600, and replace every placeholder.
POSTGRES_DB=viralforge
POSTGRES_USER=viralforge
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
VIRALFORGE_ENVIRONMENT=production
VIRALFORGE_DEPLOYMENT_MODE=production
VIRALFORGE_DATABASE_URL=postgresql+psycopg://viralforge:REPLACE_WITH_A_LONG_RANDOM_PASSWORD@postgres:5432/viralforge
VIRALFORGE_REDIS_URL=redis://redis:6379/0
VIRALFORGE_CELERY_BROKER_URL=redis://redis:6379/0
VIRALFORGE_CELERY_RESULT_BACKEND=redis://redis:6379/1
VIRALFORGE_API_SECRET=REPLACE_WITH_32_OR_MORE_RANDOM_CHARACTERS
VIRALFORGE_PREVIEW_HASHING_SECRET=REPLACE_WITH_32_OR_MORE_RANDOM_CHARACTERS
VIRALFORGE_ENABLE_DEVELOPMENT_ACTOR=false
VIRALFORGE_PUBLIC_HOST=app.example.com
VIRALFORGE_PUBLIC_BASE_URL=https://app.example.com
VIRALFORGE_API_BASE_URL=https://app.example.com
VIRALFORGE_PREVIEW_PUBLIC_BASE_URL=https://app.example.com
VIRALFORGE_OAUTH_CALLBACK_BASE_URL=https://app.example.com
VIRALFORGE_TRUSTED_HOSTS=app.example.com
VIRALFORGE_CORS_ALLOWED_ORIGINS=
VIRALFORGE_DISCORD_ENABLED=true
VIRALFORGE_DISCORD_BOT_TOKEN=REPLACE_WITH_DISCORD_BOT_TOKEN
VIRALFORGE_DISCORD_GUILD_ID=REPLACE_WITH_GUILD_ID
VIRALFORGE_DISCORD_REVIEW_CHANNEL_ID=REPLACE_WITH_CHANNEL_ID
VIRALFORGE_DISCORD_ALLOWED_ROLE_IDS=REPLACE_WITH_ROLE_ID
VIRALFORGE_PUBLISHING_ENABLED=false
VIRALFORGE_PUBLISHING_YOUTUBE_ENABLED=false
VIRALFORGE_YOUTUBE_OAUTH_ENABLED=false
VIRALFORGE_TIKTOK_ENABLED=false
VIRALFORGE_ANALYTICS_ENABLED=false
VIRALFORGE_ANALYTICS_YOUTUBE_ENABLED=false
# Optional Discord-compatible operations webhook; keep it outside Git and use
# only for state-change/recovery alerts from scripts/production/monitor.sh.
# VIRALFORGE_ALERT_WEBHOOK_URL=REPLACE_WITH_PRIVATE_WEBHOOK_URL
